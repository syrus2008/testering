      "extract": {"strip_root": true, "dest": "runtime/java", "exclude": ["jmods/", "lib/src.zip", "demo/", "man/"]}
    },
    "python": {
      "url": "https://api.nuget.org/v3-flatcontainer/python/3.11.9/python.3.11.9.nupkg",
