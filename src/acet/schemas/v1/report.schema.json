{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acet.local/schemas/v1/report.schema.json",
  "title": "ACET report v1",
  "description": "Canonical report model (spec §42). Executive and Technical views derive from it. Every scientific cell carries a MeasurementState (ACET-CLOSE-004).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "acet_version",
    "scope",
    "executive",
    "technical",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "acet-report"
    },
    "generated_at": {
      "type": "string"
    },
    "acet_version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "build",
            "compare",
            "product"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "executive": {
      "type": "object",
      "required": [
        "headline",
        "uncertainty",
        "no_global_score",
        "completeness"
      ],
      "properties": {
        "headline": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_global_score": {
          "const": true
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_status",
            "is_partial",
            "missing",
            "statement"
          ],
          "properties": {
            "run_status": {
              "type": "string"
            },
            "is_partial": {
              "type": "boolean"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "processor"
                ]
              }
            },
            "statement": {
              "type": "string"
            }
          }
        }
      }
    },
    "technical": {
      "type": "object",
      "required": [
        "runs",
        "components",
        "functions",
        "changes",
        "lineage",
        "missing_evidence"
      ],
      "properties": {
        "runs": {
          "type": "array"
        },
        "components": {
          "type": "array"
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision",
              "strength_class",
              "evidence_diversity",
              "engine_count",
              "inference_state",
              "confidence"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "EXACT",
                  "STRONG",
                  "PROBABLE",
                  "AMBIGUOUS",
                  "CONFLICT",
                  "UNRESOLVED",
                  "ABSTAIN"
                ]
              },
              "inference_state": {
                "enum": [
                  "NOT_OBSERVED",
                  "UNRESOLVED",
                  "ABSTAIN",
                  "HYPOTHESIS",
                  "AMBIGUOUS",
                  "CONFLICTING",
                  "PROBABLE",
                  "STRONG",
                  "CONFIRMED_BY_RULE"
                ]
              },
              "probability": {
                "type": "null"
              },
              "confidence": {
                "type": "object",
                "required": [
                  "display",
                  "calibration_state"
                ],
                "properties": {
                  "display": {
                    "const": "class"
                  },
                  "calibration_state": {
                    "enum": [
                      "UNCALIBRATED",
                      "OUT_OF_DISTRIBUTION",
                      "CALIBRATED"
                    ]
                  }
                }
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "measurement",
              "severity_class",
              "reliability_class"
            ],
            "properties": {
              "measurement": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "lineage": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "run_id",
            "status",
            "summary",
            "events"
          ],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "lineage_id",
                  "historical_lineage_id",
                  "relation",
                  "instance",
                  "inference_state",
                  "rule",
                  "status_text",
                  "explanation",
                  "supporting_families",
                  "contradicting_families",
                  "reasons",
                  "provenance"
                ],
                "properties": {
                  "relation": {
                    "enum": [
                      "CONTINUATION",
                      "MODIFIED",
                      "SPLIT_PARENT",
                      "MERGE_PARENT",
                      "DISAPPEARED",
                      "RESURRECTED_CANDIDATE",
                      "RESURRECTED_CONFIRMED",
                      "UNRESOLVED"
                    ]
                  },
                  "inference_state": {
                    "enum": [
                      "NOT_OBSERVED",
                      "UNRESOLVED",
                      "ABSTAIN",
                      "HYPOTHESIS",
                      "AMBIGUOUS",
                      "CONFLICTING",
                      "PROBABLE",
                      "STRONG",
                      "CONFIRMED_BY_RULE"
                    ]
                  },
                  "status_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "supporting_families": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "contradicting_families": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "provenance": {
                    "type": "object",
                    "required": [
                      "lineage_run_id",
                      "lineage_rules"
                    ]
                  }
                }
              }
            }
          }
        },
        "missing_evidence": {
          "type": "array"
        },
        "external_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interpretation"
            ],
            "properties": {
              "interpretation": {
                "const": "temporal correlation only, not a cause"
              }
            }
          }
        },
        "calibration": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "engine",
              "state",
              "text"
            ],
            "properties": {
              "state": {
                "enum": [
                  "UNCALIBRATED",
                  "OUT_OF_DISTRIBUTION",
                  "CALIBRATED"
                ]
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "profiles",
        "engines",
        "config_hashes",
        "input_hashes"
      ]
    },
    "limitations": {
      "type": "array"
    },
    "sensitive_content_included": {
      "type": "boolean"
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "MEASURED",
            "NOT_MEASURED",
            "UNSUPPORTED",
            "INCOMPATIBLE",
            "PARTIAL",
            "UNRELIABLE",
            "OUT_OF_DISTRIBUTION"
          ]
        },
        "value": {}
      }
    }
  }
}
