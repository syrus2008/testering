{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acet.local/schemas/v1/provider-manifest.schema.json",
  "title": "Engine provider manifest v1",
  "description": "Spec §18 capability model. The UI depends on capabilities, never on provider names (ACC-033).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "provider_version",
    "protocol_version",
    "capabilities",
    "executable",
    "license_mode",
    "health_check",
    "supported_formats",
    "supported_architectures"
  ],
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "provider_version": {
      "type": "string"
    },
    "protocol_version": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "DISASSEMBLY",
          "FUNCTION_EXTRACTION",
          "STRUCTURAL_DIFF",
          "PROGRAMMABLE_DIFF",
          "SEMANTIC_FEATURES",
          "REPORT_EXPORT"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "executable": {
      "type": "string"
    },
    "license_mode": {
      "enum": [
        "bundled",
        "external",
        "downloaded_by_user"
      ]
    },
    "health_check": {
      "type": "string"
    },
    "supported_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_architectures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "determinism_class": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3"
      ]
    },
    "experimental": {
      "type": "boolean"
    }
  }
}
