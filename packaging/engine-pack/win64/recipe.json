      "copy_to": "licenses/sources/mdutils-1.6.0.tar.gz"
    }
  },
  "site_packages": {
    "interpreter": "ghidriff/python.exe",
    "target": "ghidriff/Lib/site-packages",
    "install": [
      {"pack_file": "ghidra/Ghidra/Features/PyGhidra/pypkg/dist/pyghidra-2.2.1-py3-none-any.whl", "sha256": "62275e315759a06937bfa19ced4df9a7fd35a821502699f56f661dc6d8fc1ebc"},
      {"pack_file": "ghidra/Ghidra/Features/PyGhidra/pypkg/dist/jpype1-1.5.2-cp311-cp311-win_amd64.whl", "sha256": "0a0d18d4384b3df2e55282545737dfcf18c604504f1382ad14f880bef960f265"},
